# Node Environment (development | test | production)
NODE_ENV=production

# PostgreSQL Connection String (Supabase / PgBouncer transaction pooler on port 6543)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:6543/postgres?pgbouncer=true

# PostgreSQL Direct Connection String (Supabase direct session connection on port 5432 for migrations & pg_dump)
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres

# Authentication Secret for signing JWT tokens (Generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_hex_32_characters

# Base Application URL (Production HTTPS URL)
NEXT_PUBLIC_APP_URL=https://hat-exam-portal.vercel.app

# Email Delivery Configuration (Resend REST API)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="YadaSutra Examination Portal <no-reply@yadasutra.com>"
